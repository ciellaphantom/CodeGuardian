{
  "name": "codeguardian-scanner",
  "displayName": "CodeGuardian Scanner",
  "description": "A VSCode extension that sends code to CodeGuardian backend and displays security findings.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],

  "activationEvents": [
    "onCommand:codeguardian.scanCode"
  ],

  "main": "./extension.js",

  "contributes": {
    "commands": [
      {
        "command": "codeguardian.scanCode",
        "title": "CodeGuardian: Scan Code"
      }
    ]
  },

  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },

  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1"
  },

  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}




